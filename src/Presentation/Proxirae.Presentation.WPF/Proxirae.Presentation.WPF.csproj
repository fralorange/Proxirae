<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
	<AssemblyName>Proxirae</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
	<StartupObject>Proxirae.Presentation.WPF.Program</StartupObject>
	<NoWarn>IDE0290, IDE0305</NoWarn>
	<ApplicationIcon>Resources\Icons\icon.ico</ApplicationIcon>
	<Configurations>Debug;Release;Release_Win32</Configurations>
	<ApplicationManifest>Properties\app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
	<Resource Include="Resources\**\*.svg" />
	<Resource Include="Resources\**\*.png" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\Icons\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="DotNetProjects.SVGImage" Version="5.2.13" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.142" />
    <PackageReference Include="MvvmDialogs" Version="9.1.2" />
    <PackageReference Include="Sdl.MultiSelectComboBox" Version="1.0.103" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Application\Proxirae.Application\Proxirae.Application.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Proxirae.Infrastructure.ProcessCommunication\Proxirae.Infrastructure.ProcessCommunication.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Proxirae.Infrastructure.TransactionControl\Proxirae.Infrastructure.TransactionControl.csproj" />
    <ProjectReference Include="..\..\Infrastructure\Proxirae.Infrastructure\Proxirae.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\ProxyChecker\SetProxyServerView.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\ProxyRules\EditProxyRuleView.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\ProxyServers\EditProxyServerView.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Icons\icon.ico" />
  </ItemGroup>

</Project>
