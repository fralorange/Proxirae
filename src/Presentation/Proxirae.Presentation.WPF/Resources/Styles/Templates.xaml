<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:numeric="http://gu.se/NumericInput">

    <Style x:Key="RightSpinnerButtonStyle"
           TargetType="{x:Type RepeatButton}">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <ControlTemplate x:Key="RightSpinnerTemplate"
                     TargetType="{x:Type numeric:SpinnerDecorator}">
        <Border Margin="{TemplateBinding Padding}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                </Grid.ColumnDefinitions>

                <ContentPresenter Grid.Column="0"
                                  ContentSource="Child"/>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <RepeatButton x:Name="PART_IncreaseButton"
                                  Grid.Row="0"
                                  Command="{Binding Child.IncreaseCommand,
                                                    RelativeSource={RelativeSource TemplatedParent}}"
                                  Style="{StaticResource RightSpinnerButtonStyle}"
                                  Visibility="{Binding Child.AllowSpinners,
                                                    RelativeSource={RelativeSource TemplatedParent},
                                                    Converter={StaticResource BooleanToVisibilityConverter}}">

                        <Path Width="7"
                              Height="4"
                              Fill="Gray"
                              Stretch="Fill"
                              Data="M 0,4 L 3.5,0 L 7,4 Z"/>
                    </RepeatButton>

                    <RepeatButton x:Name="PART_DecreaseButton"
                                  Grid.Row="1"
                                  Command="{Binding Child.DecreaseCommand,
                                                    RelativeSource={RelativeSource TemplatedParent}}"
                                  Style="{StaticResource RightSpinnerButtonStyle}"
                                  Visibility="{Binding Child.AllowSpinners,
                                                    RelativeSource={RelativeSource TemplatedParent},
                                                    Converter={StaticResource BooleanToVisibilityConverter}}">

                        <Path Width="7"
                              Height="4"
                              Fill="Gray"
                              Stretch="Fill"
                              Data="M 0,0 L 3.5,4 L 7,0 Z"/>
                    </RepeatButton>
                </Grid>
            </Grid>
        </Border>
    </ControlTemplate>

    <Style TargetType="{x:Type numeric:SpinnerDecorator}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template"
                Value="{StaticResource RightSpinnerTemplate}"/>
    </Style>

</ResourceDictionary>