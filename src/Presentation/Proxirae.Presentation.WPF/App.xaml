<Application x:Class="Proxirae.Presentation.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:RentADeveloper.ResXLocalization.WPF;assembly=ResXLocalization.WPF"
             xmlns:local="clr-namespace:Proxirae.Presentation.WPF"
             xmlns:res="clr-namespace:Proxirae.Presentation.WPF.Resources.Localization"
             xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf">
    <Application.Resources>
        <ResourceDictionary>
            <tb:TaskbarIcon x:Key="TrayIcon"
                            IconSource="/Resources/Icons/icon.ico"
                            ToolTipText="{x:Static local:ProgramInfo.AppName}">
                <tb:TaskbarIcon.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                 Style="{StaticResource MainContextMenu}">
                        <MenuItem Header="{l:Localize {x:Static res:LocalizationKeys.TrayOpen}}" />
                        <Separator />
                        <MenuItem Header="{l:Localize {x:Static res:LocalizationKeys.TrayExit}}" />
                    </ContextMenu>
                </tb:TaskbarIcon.ContextMenu>

            </tb:TaskbarIcon>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles/Themes/Dark.xaml" />
                <ResourceDictionary Source="/Resources/Styles/Brushes.xaml" />
                <ResourceDictionary Source="/Resources/Styles/Constants.xaml" />
                <ResourceDictionary Source="/Resources/Providers/Providers.xaml" />
                <ResourceDictionary Source="/Converters/Converters.xaml" />
                <ResourceDictionary Source="Resources/Styles/Templates.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
