<UserControl x:Class="Proxirae.Presentation.WPF.Controls.TextBoxWithActions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Proxirae.Presentation.WPF.Controls"
             xmlns:svg="https://github.com/dotnetprojects/SVGImage"
             x:Name="Root">

    <UserControl.Resources>
        <Style x:Key="TextBoxWithActionsStyle"
               BasedOn="{StaticResource NeutralInput}"
               TargetType="{x:Type TextBox}">

            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                </Trigger>
            </Style.Triggers>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">

                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="0,0,60,0" />

                                <StackPanel HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Orientation="Horizontal">

                                    <Button Width="26"
                                            Height="26"
                                            Margin="2"
                                            Padding="0"
                                            Background="{StaticResource TransparentBrush}"
                                            BorderThickness="0"
                                            Command="{Binding FileCommand, RelativeSource={RelativeSource AncestorType={x:Type local:TextBoxWithActions}}}">

                                        <svg:SVGImage Width="20"
                                                      Height="20"
                                                      OverrideFillColor="{DynamicResource ProcessButtonColor}"
                                                      SizeType="ViewBoxToSizeNoStretch"
                                                      SnapsToDevicePixels="True"
                                                      Source="{Binding FileIconPath, RelativeSource={RelativeSource AncestorType={x:Type local:TextBoxWithActions}}}" />
                                    </Button>

                                    <Button Width="26"
                                            Height="26"
                                            Margin="2"
                                            Padding="0"
                                            Background="{StaticResource TransparentBrush}"
                                            BorderThickness="0"
                                            Command="{Binding FolderCommand, RelativeSource={RelativeSource AncestorType={x:Type local:TextBoxWithActions}}}">

                                        <svg:SVGImage Width="20"
                                                      Height="20"
                                                      OverrideFillColor="{DynamicResource ProcessButtonColor}"
                                                      SizeType="ViewBoxToSizeNoStretch"
                                                      SnapsToDevicePixels="True"
                                                      Source="{Binding FolderIconPath, RelativeSource={RelativeSource AncestorType={x:Type local:TextBoxWithActions}}}" />
                                    </Button>

                                </StackPanel>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <TextBox AcceptsReturn="{Binding AcceptsReturn, ElementName=Root}"
                 Style="{StaticResource TextBoxWithActionsStyle}"
                 Text="{Binding Text, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 TextWrapping="{Binding TextWrapping, ElementName=Root}" />
    </Grid>
</UserControl>