<controls:TitleBarWindow x:Class="Proxirae.Presentation.WPF.Views.ProxyRulesView"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
                         xmlns:local="clr-namespace:Proxirae.Presentation.WPF.Views"
                         xmlns:controls="clr-namespace:Proxirae.Presentation.WPF.Controls" 
                         xmlns:viewmodels="clr-namespace:Proxirae.Presentation.WPF.ViewModels"
                         md:DialogServiceViews.IsRegistered="True"
                         d:DataContext="{d:DesignInstance Type=viewmodels:ProxyRulesViewModel}"
                         mc:Ignorable="d"
                         Title="Proxy Rules"
                         MinHeight="650" 
                         MinWidth="750"
                         Height="650"
                         Width="750"
                         Background="Transparent"
                         WindowStartupLocation="CenterOwner"
                         ShowInTaskbar="False">
    <Grid Background="WhiteSmoke">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <DataGrid Grid.Row="0" 
              Grid.Column="0"
              Style="{StaticResource ControlTable}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Remarks" Width="*" />
                <DataGridTextColumn Header="Process" Width="*" />
                <DataGridTextColumn Header="Target Hosts" Width="*" />
                <DataGridTextColumn Header="Target Ports" Width="*" />
                <DataGridTextColumn Header="Protocol" Width="*" />
                <DataGridTextColumn Header="Action" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="0"
                Grid.Column="1"
                Margin="0 20 0 0">
            <Button Content="Add..."
                Style="{StaticResource ControlButton}"/>
            <Button Content="Clone"
                Style="{StaticResource ControlButton}"
                IsEnabled="False"/>
            <Button Content="Edit..."
                Style="{StaticResource ControlButton}"
                IsEnabled="False"/>
            <Button Content="Remove"
                Style="{StaticResource ControlButton}"
                IsEnabled="False"/>
        </StackPanel>


        <DockPanel Grid.Row="1"
               Grid.Column="0"
               Grid.ColumnSpan="2"
               LastChildFill="False">
            <Button Content="OK"
                Style="{StaticResource ControlButton}"
                DockPanel.Dock="Left" IsDefault="True"/>
            <Button Content="Cancel"
                Style="{StaticResource ControlButton}"
                DockPanel.Dock="Right" IsCancel="True"/>
        </DockPanel>
    </Grid>
</controls:TitleBarWindow>
