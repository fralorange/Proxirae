<controls:TitleBarWindow x:Class="Proxirae.Presentation.WPF.Views.ProxyServers.AddProxyServerView"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:l="clr-namespace:RentADeveloper.ResXLocalization.WPF;assembly=ResXLocalization.WPF"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
                         xmlns:res="clr-namespace:Proxirae.Presentation.WPF.Resources.Localization"
                         xmlns:controls="clr-namespace:Proxirae.Presentation.WPF.Controls" 
                         xmlns:viewmodels="clr-namespace:Proxirae.Presentation.WPF.ViewModels.ProxyServers"
                         md:DialogServiceViews.IsRegistered="True"
                         d:DataContext="{d:DesignInstance Type=viewmodels:AddProxyServerViewModel}"
                         mc:Ignorable="d"
                         Title="{l:Localize {x:Static res:LocalizationKeys.ProxyServerEditorTitle}}" 
                         SizeToContent="Height"
                         Width="400"
                         WindowStartupLocation="CenterOwner"
                         ShowInTaskbar="False"
                         ResizeMode="NoResize"
                         ShowMaximizeButton="False"
                         ShowMinimizeButton="False"
                         Style="{StaticResource Window}">

    <Grid Style="{StaticResource ProxyServerEditorRoot}"
          Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Header="{l:Localize {x:Static res:LocalizationKeys.ProxyServerEditorGroupHeaderServer}}" 
                  Style="{StaticResource ProxyServerEditorGroupBox}"
                  Margin="20"
                  Grid.Row="0">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" 
                                      MinWidth="80" 
                                      SharedSizeGroup="Labels"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" 
                       Grid.Column="0" 
                       Style="{StaticResource ProxyServerEditorLabel}"
                       Content="{l:Localize {x:Static res:LocalizationKeys.ProxyServerEditorRemarks}}" 
                       Margin="0 0 10 10"/>
                <TextBox Grid.Row="0" 
                         Grid.Column="1" 
                         Style="{StaticResource ProxyServerEditorInput}"
                         Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0 0 0 10"/>

                <Label Grid.Row="1" 
                       Grid.Column="0" 
                       Style="{StaticResource ProxyServerEditorLabel}"
                       Content="{l:Localize {x:Static res:LocalizationKeys.ProxyServerEditorAddress}}" 
                       Margin="0 0 10 10"/>
                <TextBox Grid.Row="1" 
                         Grid.Column="1" 
                         Style="{StaticResource ProxyServerEditorInput}"
                         Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0 0 0 10"/>

                <Label Grid.Row="2" 
                       Grid.Column="0" 
                       Style="{StaticResource ProxyServerEditorLabel}"
                       Content="{l:Localize {x:Static res:LocalizationKeys.ProxyServerEditorPort}}" 
                       Margin="0 0 10 10"/>
                <TextBox Grid.Row="2" 
                         Grid.Column="1" 
                         Style="{StaticResource ProxyServerEditorInput}"
                         Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0 0 0 10"/>

                <Label Grid.Row="3" 
                       Grid.Column="0" 
                       Style="{StaticResource ProxyServerEditorLabel}"
                       Content="{l:Localize {x:Static res:LocalizationKeys.ProxyServerEditorProtocol}}" 
                       Margin="0,0,10,0"/>
                <ComboBox Grid.Row="3" 
                          Grid.Column="1" 
                          Style="{StaticResource ProxyServerEditorComboBox}"
                          SelectedItem="{Binding Protocol, UpdateSourceTrigger=PropertyChanged}" 
                          ItemsSource="{Binding Source={StaticResource enumValues}}"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="{l:Localize {x:Static res:LocalizationKeys.ProxyServerEditorGroupHeaderAuthentication}}" 
                  Style="{StaticResource ProxyServerEditorGroupBox}"
                  Margin="20"
                  Grid.Row="1">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" 
                                      SharedSizeGroup="Labels"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <CheckBox x:Name="AuthCheck"
                          Grid.Row="0" 
                          Grid.Column="0" 
                          Grid.ColumnSpan="2"
                          Style="{StaticResource ProxyServerEditorInput}"
                          Content="{l:Localize {x:Static res:LocalizationKeys.ProxyServerEditorAuthRequired}}"
                          IsChecked="{Binding IsAuth, Mode=TwoWay}"
                          Margin="0 0 0 10"/>

                <Label Grid.Row="1" 
                       Grid.Column="0"
                       Style="{StaticResource ProxyServerEditorLabel}"
                       Content="{l:Localize {x:Static res:LocalizationKeys.ProxyServerEditorAuthUsername}}" 
                       Margin="0 0 10 10"
                       IsEnabled="{Binding IsChecked, ElementName=AuthCheck}"/>
                <TextBox Grid.Row="1" 
                         Grid.Column="1"
                         Style="{StaticResource ProxyServerEditorInput}"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0 0 0 10"
                         IsEnabled="{Binding IsChecked, ElementName=AuthCheck}"/>

                <Label Grid.Row="2" 
                       Grid.Column="0"
                       Style="{StaticResource ProxyServerEditorLabel}"
                       Content="{l:Localize {x:Static res:LocalizationKeys.ProxyServerEditorAuthPassword}}" 
                       Margin="0,0,10,0"
                       IsEnabled="{Binding IsChecked, ElementName=AuthCheck}"/>
                <PasswordBox Grid.Row="2" 
                             Grid.Column="1"
                             Style="{StaticResource ProxyServerEditorInput}"
                             IsEnabled="{Binding IsChecked, ElementName=AuthCheck}"/>
            </Grid>
        </GroupBox>

        <DockPanel Grid.Row="2"
                   LastChildFill="False"
                   VerticalAlignment="Bottom"
                   Margin="10">
            <Button Content="{l:Localize {x:Static res:LocalizationKeys.SharedCancel}}"
                    Style="{StaticResource ControlButton}"
                    IsCancel="True"
                    Command="{Binding CancelCommand}"
                    DockPanel.Dock="Right"/>

            <Button Content="{l:Localize {x:Static res:LocalizationKeys.SharedOK}}"
                    Style="{StaticResource ControlButton}"
                    IsDefault="True"
                    Command="{Binding ConfirmCommand}"
                    DockPanel.Dock="Right"/>
        </DockPanel>
    </Grid>
</controls:TitleBarWindow>