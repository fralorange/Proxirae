<controls:TitleBarWindow x:Class="Proxirae.Presentation.WPF.Views.ProxyServers.ProxyServersView"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:l="clr-namespace:RentADeveloper.ResXLocalization.WPF;assembly=ResXLocalization.WPF"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
                         xmlns:res="clr-namespace:Proxirae.Presentation.WPF.Resources.Localization"
                         xmlns:local="clr-namespace:Proxirae.Presentation.WPF.Views.ProxyServers"
                         xmlns:controls="clr-namespace:Proxirae.Presentation.WPF.Controls"
                         xmlns:behaviors="clr-namespace:Proxirae.Presentation.WPF.Behaviors"
                         xmlns:viewmodels="clr-namespace:Proxirae.Presentation.WPF.ViewModels.ProxyServers"
                         md:DialogServiceViews.IsRegistered="True"
                         mc:Ignorable="d"
                         d:DataContext="{d:DesignInstance Type=viewmodels:ProxyServersViewModel}"
                         Title="{l:Localize {x:Static res:LocalizationKeys.ProxyServersTitle}}"
                         MinHeight="300"
                         MinWidth="500"
                         Height="300"
                         Width="500"
                         WindowStartupLocation="CenterOwner"
                         ShowInTaskbar="False"
                         Style="{StaticResource Window}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid Style="{StaticResource ProxyServersViewRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <DataGrid x:Name="ProxyServersDataGrid"
                  Grid.Row="0"
                  Grid.Column="0"
                  Style="{StaticResource ControlTable}"
                  ItemsSource="{Binding ProxyServers}"
                  behaviors:DataGridFocusBehavior.ClearSelectionOnClick="True">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource TableRow}">
                    <Setter Property="behaviors:DataGridRowCommandBehavior.MouseDoubleClickCommand"
                            Value="{Binding DataContext.EditProxyServerCommand, RelativeSource={RelativeSource AncestorType=controls:TitleBarWindow}}"/>
                    <Setter Property="behaviors:DataGridRowCommandBehavior.MouseDoubleClickCommandParameter"
                            Value="{Binding SelectedItem, ElementName=ProxyServersDataGrid}"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="{l:Localize {x:Static res:LocalizationKeys.ProxyServersGridHeaderType}}"
                                    Width="*"
                                    Binding="{Binding Type}"/>
                <DataGridTextColumn Header="{l:Localize {x:Static res:LocalizationKeys.ProxyServersGridHeaderRemarks}}"
                                    Width="*"
                                    Binding="{Binding Remarks}"/>
                <DataGridTextColumn Header="{l:Localize {x:Static res:LocalizationKeys.ProxyServersGridHeaderAddress}}"
                                    Width="*"
                                    Binding="{Binding Address}"/>
                <DataGridTextColumn Header="{l:Localize {x:Static res:LocalizationKeys.ProxyServersGridHeaderPort}}"
                                    Width="*"
                                    Binding="{Binding Port}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource ProxyServersActionPanel}">
            <StackPanel.Resources>
                <Style x:Key="TaskButton"
                       TargetType="Button"
                       BasedOn="{StaticResource ControlButton}">
                    <Setter Property="IsEnabled" Value="True"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=ProxyServersDataGrid}"
                                     Value="-1">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>

            </StackPanel.Resources>
            <Button Content="{l:Localize {x:Static res:LocalizationKeys.ProxyServersButtonAdd}}"
                    Style="{StaticResource ControlButton}"
                    Command="{Binding AddProxyServerCommand}"/>
            <Button Content="{l:Localize {x:Static res:LocalizationKeys.ProxyServersButtonEdit}}"
                    Style="{StaticResource TaskButton}"
                    Command="{Binding EditProxyServerCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=ProxyServersDataGrid}"/>
            <Button Content="{l:Localize {x:Static res:LocalizationKeys.ProxyServersButtonRemove}}"
                    Style="{StaticResource TaskButton}"
                    Command="{Binding RemoveProxyServerCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=ProxyServersDataGrid}"/>
            <Button Content="{l:Localize {x:Static res:LocalizationKeys.ProxyServersButtonCheck}}"
                    Style="{StaticResource TaskButton}"
                    Command="{Binding CheckProxyServerCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=ProxyServersDataGrid}"/>
        </StackPanel>

        <UniformGrid Grid.Row="1"
                     Grid.Column="0"
                     Rows="1"
                     HorizontalAlignment="Right">
            <Button Content="{l:Localize {x:Static res:LocalizationKeys.SharedOK}}"
                    Style="{StaticResource ControlButton}"
                    IsDefault="True"
                    Command="{Binding ConfirmCommand}"/>

            <Button Content="{l:Localize {x:Static res:LocalizationKeys.SharedCancel}}"
                    Style="{StaticResource ControlButton}"
                    IsCancel="True"/>
        </UniformGrid>

        <Button Grid.Row="1"
                Grid.Column="1"
                Content="{l:Localize {x:Static res:LocalizationKeys.SharedApply}}"
                Style="{StaticResource ControlButton}"
                Command="{Binding ApplyCommand}"/>
    </Grid>
</controls:TitleBarWindow>