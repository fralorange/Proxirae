<controls:TitleBarWindow x:Class="Proxirae.Presentation.WPF.Views.ProxyServers.ProxyServersView"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:behaviors="clr-namespace:Proxirae.Presentation.WPF.Behaviors"
                         xmlns:controls="clr-namespace:Proxirae.Presentation.WPF.Controls"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                         xmlns:l="clr-namespace:RentADeveloper.ResXLocalization.WPF;assembly=ResXLocalization.WPF"
                         xmlns:local="clr-namespace:Proxirae.Presentation.WPF.Views.ProxyServers"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
                         xmlns:res="clr-namespace:Proxirae.Presentation.WPF.Resources.Localization"
                         xmlns:viewmodels="clr-namespace:Proxirae.Presentation.WPF.ViewModels.ProxyServers"
                         Title="{l:Localize {x:Static res:LocalizationKeys.ProxyServersTitle}}"
                         Width="500"
                         Height="300"
                         MinWidth="500"
                         MinHeight="300"
                         d:DataContext="{d:DesignInstance Type=viewmodels:ProxyServersViewModel}"
                         md:DialogServiceViews.IsRegistered="True"
                         ShowInTaskbar="False"
                         Style="{StaticResource Window}"
                         WindowStartupLocation="CenterOwner"
                         mc:Ignorable="d">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid Style="{StaticResource ProxyServersViewRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <DataGrid x:Name="ProxyServersDataGrid"
                  Grid.Row="0"
                  Grid.Column="0"
                  behaviors:DataGridFocusBehavior.ClearSelectionOnClick="True"
                  ItemsSource="{Binding ProxyServers}"
                  Style="{StaticResource ControlTable}">
            <DataGrid.RowStyle>
                <Style BasedOn="{StaticResource TableRow}"
                       TargetType="DataGridRow">
                    <Setter Property="behaviors:DataGridRowCommandBehavior.MouseDoubleClickCommand" Value="{Binding DataContext.EditProxyServerCommand, RelativeSource={RelativeSource AncestorType=controls:TitleBarWindow}}" />
                    <Setter Property="behaviors:DataGridRowCommandBehavior.MouseDoubleClickCommandParameter" Value="{Binding SelectedItem, ElementName=ProxyServersDataGrid}" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Width="*"
                                    Binding="{Binding Type}"
                                    Header="{l:Localize {x:Static res:LocalizationKeys.ProxyServersGridHeaderType}}" />
                <DataGridTextColumn Width="*"
                                    Binding="{Binding Remarks}"
                                    Header="{l:Localize {x:Static res:LocalizationKeys.ProxyServersGridHeaderRemarks}}" />
                <DataGridTextColumn Width="*"
                                    Binding="{Binding Address}"
                                    Header="{l:Localize {x:Static res:LocalizationKeys.ProxyServersGridHeaderAddress}}" />
                <DataGridTextColumn Width="*"
                                    Binding="{Binding Port}"
                                    Header="{l:Localize {x:Static res:LocalizationKeys.ProxyServersGridHeaderPort}}" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource ProxyServersActionPanel}">
            <StackPanel.Resources>
                <Style x:Key="TaskButton"
                       BasedOn="{StaticResource ControlButton}"
                       TargetType="Button">
                    <Setter Property="IsEnabled" Value="True" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=ProxyServersDataGrid}"
                                     Value="-1">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>

            </StackPanel.Resources>
            <Button Command="{Binding AddProxyServerCommand}"
                    Content="{l:Localize {x:Static res:LocalizationKeys.ProxyServersButtonAdd}}"
                    Style="{StaticResource ControlButton}" />
            <Button Command="{Binding EditProxyServerCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=ProxyServersDataGrid}"
                    Content="{l:Localize {x:Static res:LocalizationKeys.ProxyServersButtonEdit}}"
                    Style="{StaticResource TaskButton}" />
            <Button Command="{Binding RemoveProxyServerCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=ProxyServersDataGrid}"
                    Content="{l:Localize {x:Static res:LocalizationKeys.ProxyServersButtonRemove}}"
                    Style="{StaticResource TaskButton}" />
            <Button Command="{Binding CheckProxyServerCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=ProxyServersDataGrid}"
                    Content="{l:Localize {x:Static res:LocalizationKeys.ProxyServersButtonCheck}}"
                    Style="{StaticResource TaskButton}" />
        </StackPanel>

        <UniformGrid Grid.Row="1"
                     Grid.Column="0"
                     HorizontalAlignment="Right"
                     Rows="1">
            <Button Command="{Binding ConfirmCommand}"
                    Content="{l:Localize {x:Static res:LocalizationKeys.SharedOK}}"
                    IsDefault="True"
                    Style="{StaticResource ControlButton}" />

            <Button Content="{l:Localize {x:Static res:LocalizationKeys.SharedCancel}}"
                    IsCancel="True"
                    Style="{StaticResource ControlButton}" />
        </UniformGrid>

        <Button Grid.Row="1"
                Grid.Column="1"
                Command="{Binding ApplyCommand}"
                Content="{l:Localize {x:Static res:LocalizationKeys.SharedApply}}"
                Style="{StaticResource ControlButton}" />
    </Grid>
</controls:TitleBarWindow>