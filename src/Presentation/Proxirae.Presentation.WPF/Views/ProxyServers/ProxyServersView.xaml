<controls:TitleBarWindow x:Class="Proxirae.Presentation.WPF.Views.ProxyServers.ProxyServersView"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
                         xmlns:local="clr-namespace:Proxirae.Presentation.WPF.Views.ProxyServers"
                         xmlns:controls="clr-namespace:Proxirae.Presentation.WPF.Controls"
                         xmlns:behaviors="clr-namespace:Proxirae.Presentation.WPF.Behaviors"
                         xmlns:viewmodels="clr-namespace:Proxirae.Presentation.WPF.ViewModels.ProxyServers"
                         md:DialogServiceViews.IsRegistered="True"
                         mc:Ignorable="d"
                         d:DataContext="{d:DesignInstance Type=viewmodels:ProxyServersViewModel}"
                         Title="Proxy Servers"
                         MinHeight="300" 
                         MinWidth="500"
                         Height="300"
                         Width="500"
                         Background="Transparent"
                         WindowStartupLocation="CenterOwner"
                         ShowInTaskbar="False">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadProxyServersCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid Background="WhiteSmoke">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <DataGrid x:Name="ProxyServersDataGrid"
                  Grid.Row="0" 
                  Grid.Column="0"
                  Style="{StaticResource ControlTable}"
                  ItemsSource="{Binding ProxyServers}"
                  behaviors:DataGridFocusBehavior.ClearSelectionOnClick="True">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="behaviors:DataGridRowCommandBehavior.MouseDoubleClickCommand"
                            Value="{Binding DataContext.EditProxyServerCommand, RelativeSource={RelativeSource AncestorType=controls:TitleBarWindow}}"/>
                    <Setter Property="behaviors:DataGridRowCommandBehavior.MouseDoubleClickCommandParameter"
                            Value="{Binding SelectedItem, ElementName=ProxyServersDataGrid}"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Type" 
                                    Width="*"
                                    Binding="{Binding Type}"/>
                <DataGridTextColumn Header="Remarks" 
                                    Width="*" 
                                    Binding="{Binding Remarks}"/>
                <DataGridTextColumn Header="Address" 
                                    Width="*" 
                                    Binding="{Binding IP}"/>
                <DataGridTextColumn Header="Port" 
                                    Width="*" 
                                    Binding="{Binding Port}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="0"
                    Grid.Column="1"
                    Margin="0 20 0 0">
            <StackPanel.Resources>
                <Style x:Key="TaskButton" 
                       TargetType="Button"
                       BasedOn="{StaticResource ControlButton}">
                    <Setter Property="IsEnabled" Value="True"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=ProxyServersDataGrid}"
                                     Value="-1">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>

            </StackPanel.Resources>
            <Button Content="Add..."
                    Style="{StaticResource ControlButton}"
                    Command="{Binding AddProxyServerCommand}"/>
            <Button Content="Edit..."
                    Style="{StaticResource TaskButton}"
                    Command="{Binding EditProxyServerCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=ProxyServersDataGrid}"/>
            <Button Content="Remove"
                    Style="{StaticResource TaskButton}"
                    Command="{Binding RemoveProxyServerCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=ProxyServersDataGrid}"/>
            <Button Content="Check"
                    Style="{StaticResource TaskButton}"
                    Command="{Binding CheckProxyServerCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=ProxyServersDataGrid}"/>
        </StackPanel>


        <DockPanel Grid.Row="1"
                   Grid.Column="0"
                   Grid.ColumnSpan="2"
                   LastChildFill="False">
            <Button Content="Apply"
                    Style="{StaticResource ControlButton}"
                    DockPanel.Dock="Right"
                    Command="{Binding ApplyCommand}"/>
            <Button Content="Cancel"
                    Style="{StaticResource ControlButton}"
                    DockPanel.Dock="Right" 
                    IsCancel="True"/>
            <Button Content="OK"
                    Style="{StaticResource ControlButton}"
                    DockPanel.Dock="Right" 
                    IsDefault="True"
                    Command="{Binding ConfirmCommand}"/>
        </DockPanel>
    </Grid>
</controls:TitleBarWindow>

