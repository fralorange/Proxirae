<UserControl x:Class="Proxirae.Presentation.WPF.Views.Options.Sections.GeneralView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:RentADeveloper.ResXLocalization;assembly=ResXLocalization.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:l="clr-namespace:RentADeveloper.ResXLocalization.WPF;assembly=ResXLocalization.WPF"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:Proxirae.Presentation.WPF.Resources.Localization"
             xmlns:sections="clr-namespace:Proxirae.Presentation.WPF.ViewModels.Options.Sections"
             d:DataContext="{d:DesignInstance Type=sections:GeneralViewModel}"
             Style="{StaticResource SectionWindow}"
             mc:Ignorable="d">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--#region Localization-->
        <GroupBox Grid.Row="0"
                  Padding="10"
                  VerticalAlignment="Top"
                  Header="{l:Localize {x:Static res:LocalizationKeys.GeneralGroupHeaderLocalization}}"
                  Style="{StaticResource SectionGroupBox}">

            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center"
                               Style="{StaticResource SectionText}"
                               Text="{l:Localize {x:Static res:LocalizationKeys.GeneralLanguage}}" />

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                              Style="{StaticResource SectionComboBox}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource SectionText}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource NameToLocalizeConverter}"
                                                      ConverterParameter="GeneralLanguage">
                                            <Binding Path="Name" />
                                            <Binding Path="CurrentCulture"
                                                     Source="{x:Static core:Localizer.Current}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <TextBlock Margin="100,5,0,0"
                           Style="{StaticResource SectionSecondaryText}"
                           Text="{l:Localize {x:Static res:LocalizationKeys.GeneralLanguageDescription}}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </GroupBox>
        <!--#endregion-->

        <!--#region Startup-->
        <GroupBox Grid.Row="1"
                  Margin="0,10,0,0"
                  Padding="10"
                  VerticalAlignment="Top"
                  Header="{l:Localize {x:Static res:LocalizationKeys.GeneralGroupHeaderStartup}}"
                  Style="{StaticResource SectionGroupBox}">

            <StackPanel>

                <!--  Autostart  -->
                <StackPanel>
                    <CheckBox Content="{l:Localize {x:Static res:LocalizationKeys.GeneralAutostart}}"
                              IsChecked="{Binding Autostart, Mode=TwoWay}" />

                    <TextBlock Margin="20,3,0,8"
                               Style="{StaticResource SectionSecondaryText}"
                               Text="{l:Localize {x:Static res:LocalizationKeys.GeneralAutostartDescription}}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!--  Silent start  -->
                <StackPanel IsEnabled="{Binding Autostart}">
                    <CheckBox Margin="20,0,0,0"
                              Content="{l:Localize {x:Static res:LocalizationKeys.GeneralSilentStart}}"
                              IsChecked="{Binding SilentStart, Mode=TwoWay}"
                              IsEnabled="{Binding Autostart}" />

                    <TextBlock Margin="40,3,0,8"
                               Style="{StaticResource SectionSecondaryText}"
                               Text="{l:Localize {x:Static res:LocalizationKeys.GeneralSilentStartDescription}}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!--  Start minimized  -->
                <StackPanel IsEnabled="{Binding Autostart}">
                    <CheckBox Margin="20,0,0,0"
                              Content="{l:Localize {x:Static res:LocalizationKeys.GeneralStartMinimized}}"
                              IsChecked="{Binding StartMinimized, Mode=TwoWay}"
                              IsEnabled="{Binding Autostart}" />

                    <TextBlock Margin="40,3,0,0"
                               Style="{StaticResource SectionSecondaryText}"
                               Text="{l:Localize {x:Static res:LocalizationKeys.GeneralStartMinimizedDescription}}"
                               TextWrapping="Wrap" />
                </StackPanel>

            </StackPanel>
        </GroupBox>
        <!--#endregion-->
    </Grid>
</UserControl>