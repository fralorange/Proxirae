<UserControl x:Class="Proxirae.Presentation.WPF.Views.Options.Sections.MetricsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:Proxirae.Presentation.WPF.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:l="clr-namespace:RentADeveloper.ResXLocalization.WPF;assembly=ResXLocalization.WPF"
             xmlns:local="clr-namespace:Proxirae.Presentation.WPF.Views.Options.Sections"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:numeric="http://gu.se/NumericInput"
             xmlns:res="clr-namespace:Proxirae.Presentation.WPF.Resources.Localization"
             xmlns:sections="clr-namespace:Proxirae.Presentation.WPF.ViewModels.Options.Sections"
             d:DataContext="{d:DesignInstance Type=sections:MetricsViewModel}"
             Style="{StaticResource SectionWindow}"
             mc:Ignorable="d">

    <Grid Margin="10">
        <GroupBox Padding="10"
                  VerticalAlignment="Top"
                  Header="{l:Localize {x:Static res:LocalizationKeys.MetricsGroupHeaderBufferConfiguration}}"
                  KeyboardNavigation.TabNavigation="Cycle"
                  Style="{StaticResource SectionGroupBox}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Margin="0,0,15,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource SectionText}"
                           Text="{l:Localize {x:Static res:LocalizationKeys.MetricsRoutingBufferSize}}" />

                <numeric:SpinnerDecorator Grid.Row="0"
                                          Grid.Column="1"
                                          Focusable="False">
                    <numeric:IntBox Padding="2"
                                    VerticalContentAlignment="Center"
                                    behaviors:NumericInputBehavior.IsIntegerOnly="True"
                                    AllowSpinners="True"
                                    Increment="1"
                                    IsTabStop="True"
                                    MaxValue="10000"
                                    MinValue="10"
                                    Style="{StaticResource SectionInput}"
                                    TabIndex="1"
                                    Value="{Binding RoutingBufferSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </numeric:SpinnerDecorator>

                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           Margin="5,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource SectionSecondaryText}"
                           Text="{l:Localize {x:Static res:LocalizationKeys.MetricsEntries}}" />

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Margin="0,0,15,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource SectionText}"
                           Text="{l:Localize {x:Static res:LocalizationKeys.MetricsLogsBufferSize}}" />

                <numeric:SpinnerDecorator Grid.Row="2"
                                          Grid.Column="1"
                                          Focusable="False">
                    <numeric:IntBox Padding="2"
                                    VerticalContentAlignment="Center"
                                    behaviors:NumericInputBehavior.IsIntegerOnly="True"
                                    AllowSpinners="True"
                                    Increment="1"
                                    IsTabStop="True"
                                    MaxValue="10000"
                                    MinValue="10"
                                    Style="{StaticResource SectionInput}"
                                    TabIndex="2"
                                    Value="{Binding LogsBufferSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </numeric:SpinnerDecorator>

                <TextBlock Grid.Row="2"
                           Grid.Column="2"
                           Margin="5,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource SectionSecondaryText}"
                           Text="{l:Localize {x:Static res:LocalizationKeys.MetricsEntries}}" />
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>