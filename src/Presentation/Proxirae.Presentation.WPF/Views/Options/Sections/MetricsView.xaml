<UserControl x:Class="Proxirae.Presentation.WPF.Views.Options.Sections.MetricsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Proxirae.Presentation.WPF.Views.Options.Sections" 
             xmlns:numeric="http://gu.se/NumericInput"
             xmlns:sections="clr-namespace:Proxirae.Presentation.WPF.ViewModels.Options.Sections" 
             xmlns:behaviors="clr-namespace:Proxirae.Presentation.WPF.Behaviors"
             xmlns:l="clr-namespace:RentADeveloper.ResXLocalization.WPF;assembly=ResXLocalization.WPF"
             xmlns:res="clr-namespace:Proxirae.Presentation.WPF.Resources.Localization"
             d:DataContext="{d:DesignInstance Type=sections:MetricsViewModel}"
             mc:Ignorable="d" 
             Style="{StaticResource SectionWindow}">

    <Grid Margin="10">
        <GroupBox Header="{l:Localize {x:Static res:LocalizationKeys.MetricsGroupHeaderBufferConfiguration}}" 
                  Style="{StaticResource SectionGroupBox}"
                  VerticalAlignment="Top" 
                  Padding="10"
                  KeyboardNavigation.TabNavigation="Cycle">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" 
                           Grid.Column="0" 
                           Style="{StaticResource SectionText}"
                           Text="{l:Localize {x:Static res:LocalizationKeys.MetricsRoutingBufferSize}}" 
                           Margin="0 0 15 0"
                           VerticalAlignment="Center"/>

                <numeric:SpinnerDecorator Grid.Row="0" 
                                          Grid.Column="1"
                                          Focusable="False">
                    <numeric:IntBox Value="{Binding RoutingBufferSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource SectionInput}"
                                    VerticalContentAlignment="Center" 
                                    Padding="2"
                                    AllowSpinners="True"
                                    Increment="1"
                                    MaxValue="10000"
                                    MinValue="10"
                                    behaviors:NumericInputBehavior.IsIntegerOnly="True"
                                    TabIndex="1"
                                    IsTabStop="True"/>
                </numeric:SpinnerDecorator>

                <TextBlock Grid.Row="0" 
                           Grid.Column="2" 
                           Style="{StaticResource SectionSecondaryText}"
                           Text="{l:Localize {x:Static res:LocalizationKeys.MetricsEntries}}" 
                           Margin="5 0 0 0" 
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Row="2" 
                           Grid.Column="0" 
                           Style="{StaticResource SectionText}"
                           Text="{l:Localize {x:Static res:LocalizationKeys.MetricsLogsBufferSize}}" 
                           Margin="0 0 15 0"
                           VerticalAlignment="Center"/>

                <numeric:SpinnerDecorator Grid.Row="2" 
                                          Grid.Column="1"
                                          Focusable="False">
                    <numeric:IntBox Value="{Binding LogsBufferSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource SectionInput}"
                                    VerticalContentAlignment="Center"
                                    Padding="2"
                                    AllowSpinners="True"
                                    Increment="1"
                                    MaxValue="10000"
                                    MinValue="10"
                                    behaviors:NumericInputBehavior.IsIntegerOnly="True"
                                    TabIndex="2"
                                    IsTabStop="True"/>
                </numeric:SpinnerDecorator>

                <TextBlock Grid.Row="2" 
                           Grid.Column="2" 
                           Style="{StaticResource SectionSecondaryText}"
                           Text="{l:Localize {x:Static res:LocalizationKeys.MetricsEntries}}" 
                           Margin="5 0 0 0" 
                           VerticalAlignment="Center"/>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>