<controls:TitleBarWindow x:Class="Proxirae.Presentation.WPF.Views.Messages.ConfirmationView"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:svg="https://github.com/dotnetprojects/SVGImage"
                         xmlns:l="clr-namespace:RentADeveloper.ResXLocalization.WPF;assembly=ResXLocalization.WPF"
                         xmlns:res="clr-namespace:Proxirae.Presentation.WPF.Resources.Localization"
                         xmlns:core="clr-namespace:RentADeveloper.ResXLocalization;assembly=ResXLocalization.Core"
                         xmlns:controls="clr-namespace:Proxirae.Presentation.WPF.Controls"
                         xmlns:viewmodels="clr-namespace:Proxirae.Presentation.WPF.ViewModels.Messages"
                         d:DataContext="{d:DesignInstance Type=viewmodels:ConfirmationViewModel}"
                         mc:Ignorable="d"
                         WindowStartupLocation="CenterOwner"
                         ShowInTaskbar="False"
                         Width="400"
                         SizeToContent="Height"
                         ResizeMode="NoResize"
                         ShowCenteredTitle="True"
                         ShowMaximizeButton="False"
                         ShowMinimizeButton="False"
                         Style="{StaticResource Window}">
    <controls:TitleBarWindow.Title>
        <MultiBinding Converter="{StaticResource NameToLocalizeConverter}" 
                      ConverterParameter="ConfirmationMessage">
            <Binding Path="Title"/>
            <Binding Path="CurrentCulture" 
                     Source="{x:Static core:Localizer.Current}"/>
        </MultiBinding>
    </controls:TitleBarWindow.Title>

    <Border Background="{DynamicResource BackgroundBrush}"
            Padding="16">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0 0 0 18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <svg:SVGImage Source="../Resources/Vectors/confirmation.svg"
                              Style="{StaticResource ConfirmationMessageIcon}"/>

                <TextBlock Grid.Column="1"
                           Foreground="{DynamicResource ForegroundBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="10 0 0 0">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource NameToLocalizeConverter}" 
                                      ConverterParameter="ConfirmationMessage">
                            <Binding Path="Message"/>
                            <Binding Path="CurrentCulture" 
                                     Source="{x:Static core:Localizer.Current}"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="{l:Localize {x:Static res:LocalizationKeys.ConfirmationMessageYes}}"
                        Command="{Binding YesCommand}"
                        Style="{StaticResource ControlButton}"
                        Margin="0 0 10 0"
                        IsDefault="True"/>

                <Button Content="{l:Localize {x:Static res:LocalizationKeys.ConfirmationMessageNo}}"
                        Command="{Binding NoCommand}"
                        Style="{StaticResource ControlButton}"
                        Margin="0 0 10 0"/>

                <Button Content="{l:Localize {x:Static res:LocalizationKeys.SharedCancel}}"
                        Command="{Binding CancelCommand}"
                        Margin="0"
                        IsCancel="True">
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource ControlButton}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowCancelButton}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>
    </Border>

</controls:TitleBarWindow>
