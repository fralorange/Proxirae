<controls:TitleBarWindow x:Class="Proxirae.Presentation.WPF.Views.About.AboutView"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:about="clr-namespace:Proxirae.Presentation.WPF.ViewModels.About"
                         xmlns:controls="clr-namespace:Proxirae.Presentation.WPF.Controls"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:l="clr-namespace:RentADeveloper.ResXLocalization.WPF;assembly=ResXLocalization.WPF"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:res="clr-namespace:Proxirae.Presentation.WPF.Resources.Localization"
                         Title="{l:Localize {x:Static res:LocalizationKeys.AboutTitle}}"
                         Width="320"
                         d:DataContext="{d:DesignInstance Type=about:AboutViewModel}"
                         ResizeMode="NoResize"
                         ShowInTaskbar="False"
                         ShowMaximizeButton="False"
                         ShowMinimizeButton="False"
                         SizeToContent="Height"
                         Style="{StaticResource Window}"
                         WindowStartupLocation="CenterOwner"
                         mc:Ignorable="d">

    <Grid Style="{StaticResource AboutViewRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,20,30,0"
                    HorizontalAlignment="Center">

            <StackPanel Margin="0,0,0,20"
                        Orientation="Horizontal">
                <Image Width="80"
                       Height="80"
                       Margin="0,0,15,0"
                       VerticalAlignment="Center"
                       Source="/Proxirae;component/Resources/Icons/icon.ico" />

                <StackPanel HorizontalAlignment="Left"
                            VerticalAlignment="Center">

                    <TextBlock HorizontalAlignment="Left"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Text="{Binding AppName}" />

                    <TextBlock Style="{StaticResource AboutVersionText}"
                               Text="{Binding AppVersion}" />
                </StackPanel>
            </StackPanel>

            <StackPanel HorizontalAlignment="Left">
                <TextBlock HorizontalAlignment="Left"
                           Text="{l:Localize {x:Static res:LocalizationKeys.AboutCopyright}}" />

                <TextBlock Margin="0,8,0,0"
                           HorizontalAlignment="Left"
                           Text="{l:Localize {x:Static res:LocalizationKeys.AboutLicense}}" />

                <TextBlock Margin="0,8,0,0"
                           HorizontalAlignment="Left">
                    <Hyperlink Command="{Binding OpenLinkCommand}"
                               CommandParameter="https://github.com/fralorange/Proxirae"
                               NavigateUri="https://github.com/fralorange/Proxirae">
                        https://github.com/fralorange/Proxirae
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <Button Grid.Row="1"
                Margin="15,35,15,15"
                HorizontalAlignment="Right"
                Content="{l:Localize {x:Static res:LocalizationKeys.SharedOK}}"
                IsCancel="True"
                IsDefault="True"
                Style="{StaticResource ControlButton}" />
    </Grid>
</controls:TitleBarWindow>