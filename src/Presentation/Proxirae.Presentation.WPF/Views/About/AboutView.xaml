<controls:TitleBarWindow x:Class="Proxirae.Presentation.WPF.Views.About.AboutView"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:controls="clr-namespace:Proxirae.Presentation.WPF.Controls"
                         xmlns:about="clr-namespace:Proxirae.Presentation.WPF.ViewModels.About"
                         d:DataContext="{d:DesignInstance Type=about:AboutViewModel}"
                         mc:Ignorable="d"
                         Title="{Binding AppName, StringFormat=About {0}}"
                         Background="Transparent"
                         WindowStartupLocation="CenterOwner"
                         ShowInTaskbar="False"
                         SizeToContent="Height"
                         ResizeMode="NoResize"
                         Width="320">

    <Grid Background="WhiteSmoke">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    HorizontalAlignment="Center"
                    Margin="0 20 30 0">

            <StackPanel Orientation="Horizontal" Margin="0 0 0 20">
                <Image Source="/Proxirae;component/Resources/Icons/icon.ico"
                       Width="80"
                       Height="80"
                       Margin="0 0 15 0"
                       VerticalAlignment="Center"/>

                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Left">

                    <TextBlock Text="{Binding AppName}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Left" />

                    <TextBlock Text="{Binding AppVersion}"
                               Margin="1 4 0 0"
                               FontSize="13"
                               HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>

            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="Copyright (c) 2026 Alexei Rodionov" 
                           HorizontalAlignment="Left"/>

                <TextBlock Text="Licensed under the GNU GPL v3.0"
                           Margin="0 8 0 0" 
                           HorizontalAlignment="Left"/>

                <TextBlock Margin="0 8 0 0" HorizontalAlignment="Left">
                    <Hyperlink NavigateUri="https://github.com/fralorange/Proxirae"
                               Command="{Binding OpenLinkCommand}"
                               CommandParameter="https://github.com/fralorange/Proxirae">
                        https://github.com/fralorange/Proxirae
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <Button Grid.Row="1"
                Content="OK"
                Style="{StaticResource ControlButton}"
                HorizontalAlignment="Right"
                IsDefault="True"
                IsCancel="True"
                Margin="15 35 15 15"/>
    </Grid>
</controls:TitleBarWindow>