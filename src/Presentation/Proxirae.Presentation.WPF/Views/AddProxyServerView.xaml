<controls:TitleBarWindow x:Class="Proxirae.Presentation.WPF.Views.AddProxyServerView"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
                         xmlns:enum="clr-namespace:Proxirae.Contracts.DTOs.Proxy;assembly=Proxirae.Contracts"
                         xmlns:system="clr-namespace:System;assembly=mscorlib"
                         xmlns:local="clr-namespace:Proxirae.Presentation.WPF.Views"
                         xmlns:controls="clr-namespace:Proxirae.Presentation.WPF.Controls" 
                         xmlns:viewmodels="clr-namespace:Proxirae.Presentation.WPF.ViewModels"
                         md:DialogServiceViews.IsRegistered="True"
                         d:DataContext="{d:DesignInstance Type=viewmodels:AddProxyServerViewModel}"
                         mc:Ignorable="d"
                         Title="Proxy Server" 
                         MinHeight="500"
                         MinWidth="400"
                         Height="500" 
                         Width="400"
                         Background="Transparent"
                         WindowStartupLocation="CenterOwner"
                         ShowInTaskbar="False">
    <controls:TitleBarWindow.Resources>
        <ObjectDataProvider x:Key="enumValues"
                            MethodName="GetValues" 
                            ObjectType="{x:Type system:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enum:ProxyTypeDto"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </controls:TitleBarWindow.Resources>
    <Grid Background="WhiteSmoke">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <GroupBox Header="Server" 
                  Margin="20"
                  Grid.Row="0">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                    <Label Content="Remarks:" Width="80"/>
                    <TextBox Width="200" Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                    <Label Content="Address:" Width="80"/>
                    <TextBox Width="200" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                    <Label Content="Port:" Width="80"/>
                    <TextBox Width="200" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                    <Label Content="Protocol:" Width="80"/>
                    <ComboBox Width="200" SelectedItem="{Binding Protocol, UpdateSourceTrigger=PropertyChanged}" 
                              ItemsSource="{Binding Source={StaticResource enumValues}}"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="Authentication" 
                  Margin="20"
                  Grid.Row="1">
            <StackPanel Margin="10">
                <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                    <Label Content="Username (Optional):" Width="140"/>
                    <TextBox Width="140" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                    <Label Content="Password (Optional):" Width="140"/>
                    <PasswordBox Width="140" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <DockPanel Grid.Row="4"
                   LastChildFill="False"
                   VerticalAlignment="Bottom"
                   Margin="20">

            <Button Content="OK"
                    Style="{StaticResource ControlButton}"
                    IsDefault="True"
                    Command="{Binding ConfirmCommand}"/>

            <Button Content="Check"
                    Style="{StaticResource ControlButton}"/>

            <Button Content="Cancel"
                    Style="{StaticResource ControlButton}"
                    IsCancel="True"
                    DockPanel.Dock="Right"
                    Command="{Binding CancelCommand}"/>
        </DockPanel>
    </Grid>
</controls:TitleBarWindow>
