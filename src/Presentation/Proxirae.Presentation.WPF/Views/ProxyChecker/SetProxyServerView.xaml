<controls:TitleBarWindow x:Class="Proxirae.Presentation.WPF.Views.ProxyChecker.SetProxyServerView"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:controls="clr-namespace:Proxirae.Presentation.WPF.Controls"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:l="clr-namespace:RentADeveloper.ResXLocalization.WPF;assembly=ResXLocalization.WPF"
                         xmlns:local="clr-namespace:Proxirae.Presentation.WPF.Views.ProxyChecker"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
                         xmlns:res="clr-namespace:Proxirae.Presentation.WPF.Resources.Localization"
                         xmlns:viewmodels="clr-namespace:Proxirae.Presentation.WPF.ViewModels.ProxyChecker"
                         Title="{l:Localize {x:Static res:LocalizationKeys.ProxyServerEditorTitle}}"
                         Width="400"
                         Height="450"
                         MinWidth="400"
                         MinHeight="450"
                         d:DataContext="{d:DesignInstance Type=viewmodels:SetProxyServerViewModel}"
                         md:DialogServiceViews.IsRegistered="True"
                         ResizeMode="NoResize"
                         ShowInTaskbar="False"
                         ShowMaximizeButton="False"
                         ShowMinimizeButton="False"
                         Style="{StaticResource Window}"
                         WindowStartupLocation="CenterOwner"
                         mc:Ignorable="d">
    <Grid Grid.IsSharedSizeScope="True"
          Style="{StaticResource ProxyServerEditorRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0"
                  Margin="20"
                  Header="{l:Localize {x:Static res:LocalizationKeys.ProxyServerEditorGroupHeaderServer}}"
                  Style="{StaticResource ProxyServerEditorGroupBox}">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"
                                      SharedSizeGroup="Labels" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0"
                       Grid.Column="0"
                       Margin="0,0,10,10"
                       Content="{l:Localize {x:Static res:LocalizationKeys.ProxyServerEditorAddress}}"
                       Style="{StaticResource ProxyServerEditorLabel}" />
                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Margin="0,0,0,10"
                         Style="{StaticResource ProxyServerEditorInput}"
                         Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />

                <Label Grid.Row="1"
                       Grid.Column="0"
                       Margin="0,0,10,10"
                       Content="{l:Localize {x:Static res:LocalizationKeys.ProxyServerEditorPort}}"
                       Style="{StaticResource ProxyServerEditorLabel}" />
                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Margin="0,0,0,10"
                         Style="{StaticResource ProxyServerEditorInput}"
                         Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" />

                <Label Grid.Row="2"
                       Grid.Column="0"
                       Margin="0,0,10,0"
                       Content="{l:Localize {x:Static res:LocalizationKeys.ProxyServerEditorProtocol}}"
                       Style="{StaticResource ProxyServerEditorLabel}" />
                <ComboBox Grid.Row="2"
                          Grid.Column="1"
                          ItemsSource="{Binding Source={StaticResource enumValues}}"
                          SelectedItem="{Binding Protocol, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource ProxyServerEditorComboBox}" />
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="1"
                  Margin="20"
                  Header="{l:Localize {x:Static res:LocalizationKeys.ProxyServerEditorGroupHeaderAuthentication}}"
                  Style="{StaticResource ProxyServerEditorGroupBox}">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"
                                      SharedSizeGroup="Labels" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <CheckBox x:Name="AuthCheck"
                          Grid.Row="0"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          Margin="0,0,0,10"
                          Content="{l:Localize {x:Static res:LocalizationKeys.ProxyServerEditorAuthRequired}}"
                          IsChecked="{Binding IsAuth, Mode=TwoWay}"
                          Style="{StaticResource ProxyServerEditorInput}" />

                <Label Grid.Row="1"
                       Grid.Column="0"
                       Margin="0,0,10,10"
                       Content="{l:Localize {x:Static res:LocalizationKeys.ProxyServerEditorAuthUsername}}"
                       IsEnabled="{Binding IsChecked, ElementName=AuthCheck}"
                       Style="{StaticResource ProxyServerEditorLabel}" />

                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Margin="0,0,0,10"
                         IsEnabled="{Binding IsChecked, ElementName=AuthCheck}"
                         Style="{StaticResource ProxyServerEditorInput}"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />

                <Label Grid.Row="2"
                       Grid.Column="0"
                       Margin="0,0,10,0"
                       Content="{l:Localize {x:Static res:LocalizationKeys.ProxyServerEditorAuthPassword}}"
                       IsEnabled="{Binding IsChecked, ElementName=AuthCheck}"
                       Style="{StaticResource ProxyServerEditorLabel}" />

                <PasswordBox Grid.Row="2"
                             Grid.Column="1"
                             IsEnabled="{Binding IsChecked, ElementName=AuthCheck}"
                             Style="{StaticResource ProxyServerEditorInput}" />
            </Grid>
        </GroupBox>

        <DockPanel Grid.Row="2"
                   Margin="10"
                   VerticalAlignment="Bottom"
                   LastChildFill="False">

            <Button Content="{l:Localize {x:Static res:LocalizationKeys.SharedCancel}}"
                    DockPanel.Dock="Right"
                    IsCancel="True"
                    Style="{StaticResource ControlButton}" />

            <Button Command="{Binding ConfirmCommand}"
                    Content="{l:Localize {x:Static res:LocalizationKeys.SharedOK}}"
                    DockPanel.Dock="Right"
                    IsDefault="True"
                    Style="{StaticResource ControlButton}" />
        </DockPanel>
    </Grid>
</controls:TitleBarWindow>
