<controls:TitleBarWindow x:Class="Proxirae.Presentation.WPF.Views.ProxyChecker.ProxyCheckerView"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:l="clr-namespace:RentADeveloper.ResXLocalization.WPF;assembly=ResXLocalization.WPF"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
                         xmlns:res="clr-namespace:Proxirae.Presentation.WPF.Resources.Localization"
                         xmlns:core="clr-namespace:RentADeveloper.ResXLocalization;assembly=ResXLocalization.Core"
                         xmlns:controls="clr-namespace:Proxirae.Presentation.WPF.Controls" 
                         xmlns:viewmodels="clr-namespace:Proxirae.Presentation.WPF.ViewModels.ProxyChecker" 
                         d:DataContext="{d:DesignInstance Type=viewmodels:ProxyCheckerViewModel}"
                         md:DialogServiceViews.IsRegistered="True"
                         mc:Ignorable="d"
                         Title="{l:Localize {x:Static res:LocalizationKeys.ProxyCheckerTitle}}"
                         WindowStartupLocation="CenterOwner"
                         ShowInTaskbar="False"
                         Width="420"
                         SizeToContent="Height"
                         ResizeMode="NoResize"
                         ShowMaximizeButton="False"
                         ShowMinimizeButton="False"
                         Style="{StaticResource Window}">

    <Grid Style="{StaticResource ProxyCheckerViewRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="{l:Localize {x:Static res:LocalizationKeys.ProxyCheckerGroupHeaderTestProxy}}"
                  Style="{StaticResource ProxyCheckerGroupBox}"
                  Grid.Row="0"
                  Margin="10"
                  Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid x:Name="ProxyDetailsText" 
                      Visibility="{Binding IsProxySet, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter='Hidden'}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" 
                               Grid.Column="0" 
                               Text="{l:Localize {x:Static res:LocalizationKeys.ProxyCheckerServer}}" 
                               Margin="0 0 0 4"/>
                    <TextBlock Grid.Row="0" 
                               Grid.Column="1" 
                               Margin="0 0 0 4">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}:{1}">
                                <Binding Path="ProxyServer.Address"/>
                                <Binding Path="ProxyServer.Port"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="{l:Localize {x:Static res:LocalizationKeys.ProxyCheckerProtocol}}"/>
                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Text="{Binding ProxyServer.Type}"/>
                </Grid>

                <TextBlock Text="{l:Localize {x:Static res:LocalizationKeys.ProxyCheckerNoProxySelected}}"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Visibility, ElementName=ProxyDetailsText}" Value="Visible">
                                    <Setter Property="Visibility" Value="Hidden"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Button Grid.Column="1"
                        Content="{l:Localize {x:Static res:LocalizationKeys.ProxyCheckerButtonSet}}"
                        Margin="10 0 0 0"
                        VerticalAlignment="Center"
                        Style="{StaticResource ControlButton}"
                        Command="{Binding SetProxyServerCommand}"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="{l:Localize {x:Static res:LocalizationKeys.ProxyCheckerGroupHeaderTestTarget}}"
                  Style="{StaticResource ProxyCheckerGroupBox}"
                  Grid.Row="1"
                  Margin="10"
                  Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{l:Localize {x:Static res:LocalizationKeys.ProxyCheckerUrl}}"
                           Grid.Row="0"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="0 0 0 5"/>

                <TextBox Text="{Binding TestAddress, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ProxyCheckerInput}"
                         Grid.Row="0"
                         Grid.Column="1"
                         Margin="0 0 0 5"
                         Padding="2"/>

                <TextBlock Text="{l:Localize {x:Static res:LocalizationKeys.ProxyCheckerPort}}"
                           Grid.Row="1"
                           Grid.Column="0"
                           VerticalAlignment="Center"/>

                <TextBox Text="{Binding TestPort, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ProxyCheckerInput}"
                         Grid.Row="1"
                         Grid.Column="1"
                         Padding="2"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="{l:Localize {x:Static res:LocalizationKeys.ProxyCheckerGroupHeaderTestResults}}"
                  Style="{StaticResource ProxyCheckerGroupBox}"
                  Grid.Row="2"
                  Margin="10"
                  Padding="10">
            <StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0 0 0 8">
                    <TextBlock Text="{l:Localize {x:Static res:LocalizationKeys.ProxyCheckerStatus}}"/>
                    <TextBlock>
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource NameToLocalizeConverter}"
                                          ConverterParameter="ProxyCheckerProgress">
                                <Binding Path="StatusMessage"/>
                                <Binding Path="CurrentCulture"
                                         Source="{x:Static core:Localizer.Current}"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <ProgressBar Height="15"
                             Minimum="0"
                             Maximum="3"
                             Style="{StaticResource ProxyCheckerProgressBar}"
                             Value="{Binding ProgressValue}"
                             Margin="0 0 0 8"/>

                <Grid MinHeight="16">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsSuccess, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource LatencyBlock}" 
                                   Text="{l:Localize {x:Static res:LocalizationKeys.ProxyCheckerLatency}}"/>
                        <TextBlock Style="{StaticResource LatencyBlock}" 
                                   Text="{Binding LatencyMessage}"/>
                    </StackPanel>

                    <TextBlock Style="{StaticResource StatusBlock}"
                               Text="{l:Localize {x:Static res:LocalizationKeys.ProxyCheckerProxyCheckFailed}}" 
                               Visibility="{Binding IsFailed, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Bottom">

            <Button Content="{l:Localize {x:Static res:LocalizationKeys.ProxyCheckerButtonTest}}" 
                    Style="{StaticResource ControlButton}"
                    Command="{Binding TestCommand}"
                    IsDefault="True" 
                    Margin="0 0 10 0"
                    VerticalAlignment="Center"/>

            <Button Content="{l:Localize {x:Static res:LocalizationKeys.SharedClose}}" 
                    Style="{StaticResource ControlButton}"
                    IsCancel="True"
                    VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</controls:TitleBarWindow>