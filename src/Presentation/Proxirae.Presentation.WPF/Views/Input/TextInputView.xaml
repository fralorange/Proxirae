<controls:TitleBarWindow x:Class="Proxirae.Presentation.WPF.Views.Input.TextInputView"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:controls="clr-namespace:Proxirae.Presentation.WPF.Controls"
                         xmlns:core="clr-namespace:RentADeveloper.ResXLocalization;assembly=ResXLocalization.Core"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:l="clr-namespace:RentADeveloper.ResXLocalization.WPF;assembly=ResXLocalization.WPF"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:res="clr-namespace:Proxirae.Presentation.WPF.Resources.Localization"
                         xmlns:svg="https://github.com/dotnetprojects/SVGImage"
                         xmlns:viewmodels="clr-namespace:Proxirae.Presentation.WPF.ViewModels.Input"
                         Width="450"
                         d:DataContext="{d:DesignInstance Type=viewmodels:TextInputViewModel}"
                         ResizeMode="NoResize"
                         ShowInTaskbar="False"
                         ShowMaximizeButton="False"
                         ShowMinimizeButton="False"
                         SizeToContent="Height"
                         Style="{StaticResource Window}"
                         WindowStartupLocation="CenterOwner"
                         mc:Ignorable="d">

    <controls:TitleBarWindow.Title>
        <MultiBinding Converter="{StaticResource NameToLocalizeConverter}"
                      ConverterParameter="TextInputMessage">
            <Binding Path="Title" />
            <Binding Path="CurrentCulture"
                     Source="{x:Static core:Localizer.Current}" />
        </MultiBinding>
    </controls:TitleBarWindow.Title>

    <Border Padding="16"
            Background="{DynamicResource BackgroundBrush}">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <svg:SVGImage Source="../Resources/Vectors/info.svg"
                              Style="{StaticResource InfoMessageIcon}" />

                <TextBlock Grid.Column="1"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource ForegroundBrush}"
                           TextWrapping="Wrap">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource NameToLocalizeConverter}"
                                      ConverterParameter="TextInputMessage">
                            <Binding Path="Message" />
                            <Binding Path="CurrentCulture"
                                     Source="{x:Static core:Localizer.Current}" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </Grid>

            <TextBox Grid.Row="1"
                     Margin="0,0,0,18"
                     Style="{StaticResource NeutralInput}"
                     Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Grid.Row="2"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Command="{Binding OkCommand}"
                        Content="{l:Localize {x:Static res:LocalizationKeys.SharedOK}}"
                        IsDefault="True"
                        Style="{StaticResource ControlButton}" />

                <Button Command="{Binding AlternativeCommand}">
                    <Button.Content>
                        <MultiBinding Converter="{StaticResource NameToLocalizeConverter}"
                                      ConverterParameter="TextInputMessage">
                            <Binding Path="AlternativeButtonText" />
                            <Binding Path="CurrentCulture"
                                     Source="{x:Static core:Localizer.Current}" />
                        </MultiBinding>
                    </Button.Content>

                    <Button.Style>
                        <Style BasedOn="{StaticResource ControlButton}"
                               TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowAlternativeButton}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Command="{Binding CancelCommand}"
                        Content="{l:Localize {x:Static res:LocalizationKeys.SharedCancel}}"
                        IsCancel="True"
                        Style="{StaticResource ControlButton}" />
            </StackPanel>
        </Grid>
    </Border>
</controls:TitleBarWindow>