<controls:TitleBarWindow x:Class="Proxirae.Presentation.WPF.Views.ProxyRules.EditProxyRuleView"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:controls="clr-namespace:Proxirae.Presentation.WPF.Controls"
                         xmlns:core="clr-namespace:RentADeveloper.ResXLocalization;assembly=ResXLocalization.Core"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                         xmlns:l="clr-namespace:RentADeveloper.ResXLocalization.WPF;assembly=ResXLocalization.WPF"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
                         xmlns:res="clr-namespace:Proxirae.Presentation.WPF.Resources.Localization"
                         xmlns:viewmodels="clr-namespace:Proxirae.Presentation.WPF.ViewModels.ProxyRules"
                         Title="{l:Localize {x:Static res:LocalizationKeys.ProxyRulesEditorTitle}}"
                         Width="700"
                         Height="500"
                         MinWidth="700"
                         MinHeight="500"
                         d:DataContext="{d:DesignInstance Type=viewmodels:EditProxyRuleViewModel}"
                         md:DialogServiceViews.IsRegistered="True"
                         ShowInTaskbar="False"
                         ShowMaximizeButton="False"
                         ShowMinimizeButton="False"
                         Style="{StaticResource Window}"
                         WindowStartupLocation="CenterOwner"
                         mc:Ignorable="d">

    <Grid Style="{StaticResource ProxyRulesEditorRoot}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <GroupBox Margin="0,0,0,10"
                      Header="{l:Localize {x:Static res:LocalizationKeys.ProxyRulesEditorGroupHeaderRule}}"
                      Style="{StaticResource ProxyRulesEditorGroupBox}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Label VerticalAlignment="Center"
                           Content="{l:Localize {x:Static res:LocalizationKeys.ProxyRulesEditorRemarks}}"
                           Style="{StaticResource ProxyRulesEditorLabel}"
                           Target="{Binding ElementName=RemarksBox}" />

                    <TextBox x:Name="RemarksBox"
                             Grid.Column="1"
                             Margin="0,0,10,0"
                             VerticalAlignment="Center"
                             Style="{StaticResource ProxyRulesEditorInput}"
                             Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}" />

                    <CheckBox x:Name="EnabledBox"
                              Grid.Column="2"
                              Margin="0,0,5,0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" />

                    <Label Grid.Column="3"
                           VerticalAlignment="Center"
                           Content="{l:Localize {x:Static res:LocalizationKeys.ProxyRulesEditorEnabled}}"
                           Style="{StaticResource ProxyRulesEditorLabel}"
                           Target="{Binding ElementName=EnabledBox}" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="1"
                      Margin="0,0,0,10"
                      Header="{l:Localize {x:Static res:LocalizationKeys.ProxyRulesEditorGroupHeaderMatching}}"
                      Style="{StaticResource ProxyRulesEditorGroupBox}">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Label Content="{l:Localize {x:Static res:LocalizationKeys.ProxyRulesEditorProcesses}}"
                           Style="{StaticResource ProxyRulesEditorLabel}"
                           Target="{Binding ElementName=ProcessesBox}" />

                    <TextBox x:Name="ProcessesBox"
                             Grid.Column="1"
                             MinHeight="60"
                             VerticalAlignment="Top"
                             AcceptsReturn="True"
                             Style="{StaticResource FilePickerInput}"
                             Text="{Binding Processes, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                             TextWrapping="Wrap" />

                    <Label Grid.Row="1"
                           Margin="0,8,0,0"
                           Content="{l:Localize {x:Static res:LocalizationKeys.ProxyRulesEditorHosts}}"
                           Style="{StaticResource ProxyRulesEditorLabel}"
                           Target="{Binding ElementName=HostsBox}" />

                    <TextBox x:Name="HostsBox"
                             Grid.Row="1"
                             Grid.Column="1"
                             MinHeight="60"
                             Margin="0,8,0,0"
                             VerticalAlignment="Top"
                             AcceptsReturn="True"
                             Style="{StaticResource ProxyRulesEditorInput}"
                             Text="{Binding Hosts, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" />

                    <Label Grid.Row="2"
                           Margin="0,8,0,0"
                           Content="{l:Localize {x:Static res:LocalizationKeys.ProxyRulesEditorPorts}}"
                           Style="{StaticResource ProxyRulesEditorLabel}"
                           Target="{Binding ElementName=PortsBox}" />

                    <TextBox x:Name="PortsBox"
                             Grid.Row="2"
                             Grid.Column="1"
                             Margin="0,8,0,0"
                             VerticalAlignment="Top"
                             Style="{StaticResource ProxyRulesEditorInput}"
                             Text="{Binding Ports, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="2"
                      Header="{l:Localize {x:Static res:LocalizationKeys.ProxyRulesEditorGroupHeaderTransport}}"
                      Style="{StaticResource ProxyRulesEditorGroupBox}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Label Grid.Row="0"
                           Content="{l:Localize {x:Static res:LocalizationKeys.ProxyRulesEditorProtocol}}"
                           Style="{StaticResource ProxyRulesEditorLabel}"
                           Target="{Binding ElementName=ProtocolList}" />

                    <controls:MultiComboBox x:Name="ProtocolList"
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            ItemsSource="{Binding Protocols, Mode=OneWay}"
                                            SelectedItems="{Binding SelectedProtocols, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource ProxyRulesEditorMultiComboBox}" />

                    <Label Grid.Row="1"
                           Margin="0,8,0,0"
                           Content="{l:Localize {x:Static res:LocalizationKeys.ProxyRulesEditorAction}}"
                           Style="{StaticResource ProxyRulesEditorLabel}"
                           Target="{Binding ElementName=ActionBox}" />

                    <ComboBox x:Name="ActionBox"
                              Grid.Row="1"
                              Grid.Column="1"
                              Margin="0,8,0,0"
                              ItemsSource="{Binding Actions}"
                              SelectedItem="{Binding SelectedAction, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource ProxyRulesEditorComboBox}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource ActionToLocalizeConverter}">
                                            <Binding />
                                            <Binding Path="CurrentCulture"
                                                     Source="{x:Static core:Localizer.Current}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="1"
                    Margin="10"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">

            <Button Command="{Binding ConfirmCommand}"
                    Content="{l:Localize {x:Static res:LocalizationKeys.SharedOK}}"
                    IsDefault="True"
                    Style="{StaticResource ControlButton}" />

            <Button Content="{l:Localize {x:Static res:LocalizationKeys.SharedCancel}}"
                    IsCancel="True"
                    Style="{StaticResource ControlButton}" />
        </StackPanel>

    </Grid>
</controls:TitleBarWindow>