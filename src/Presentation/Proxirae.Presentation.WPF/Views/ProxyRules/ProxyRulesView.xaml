<controls:TitleBarWindow x:Class="Proxirae.Presentation.WPF.Views.ProxyRules.ProxyRulesView"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:l="clr-namespace:RentADeveloper.ResXLocalization.WPF;assembly=ResXLocalization.WPF"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
                         xmlns:res="clr-namespace:Proxirae.Presentation.WPF.Resources.Localization"
                         xmlns:core="clr-namespace:RentADeveloper.ResXLocalization;assembly=ResXLocalization.Core"
                         xmlns:local="clr-namespace:Proxirae.Presentation.WPF.Views.ProxyRules"
                         xmlns:controls="clr-namespace:Proxirae.Presentation.WPF.Controls"
                         xmlns:behaviors="clr-namespace:Proxirae.Presentation.WPF.Behaviors"
                         xmlns:viewmodels="clr-namespace:Proxirae.Presentation.WPF.ViewModels.ProxyRules"
                         md:DialogServiceViews.IsRegistered="True"
                         d:DataContext="{d:DesignInstance Type=viewmodels:ProxyRulesViewModel}"
                         mc:Ignorable="d"
                         Title="{l:Localize {x:Static res:LocalizationKeys.ProxyRulesTitle}}"
                         MinHeight="650" 
                         MinWidth="750"
                         Height="650"
                         Width="750"
                         Background="Transparent"
                         WindowStartupLocation="CenterOwner"
                         ShowInTaskbar="False">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid Background="WhiteSmoke">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <DataGrid x:Name="ProxyRulesDataGrid"
                  Grid.Row="0" 
                  Grid.Column="0"
                  Style="{StaticResource ControlTable}"
                  ItemsSource="{Binding ProxyRules}"
                  CanUserSortColumns="False"
                  behaviors:DataGridFocusBehavior.ClearSelectionOnClick="True">
            <i:Interaction.Behaviors>
                <behaviors:DataGridPreventRowSelectionBehavior/>
            </i:Interaction.Behaviors>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="behaviors:DataGridRowCommandBehavior.MouseDoubleClickCommand"
                            Value="{Binding DataContext.EditProxyRuleCommand, RelativeSource={RelativeSource AncestorType=controls:TitleBarWindow}}"/>
                    <Setter Property="behaviors:DataGridRowCommandBehavior.MouseDoubleClickCommandParameter"
                            Value="{Binding SelectedItem, ElementName=ProxyRulesDataGrid}"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="{l:Localize {x:Static res:LocalizationKeys.ProxyRulesGridHeaderRemarks}}"
                                        Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                          Margin="0 5 5 5">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="Checked">
                                            <i:InvokeCommandAction Command="{Binding DataContext.UpdateProxyRuleCommand, RelativeSource={RelativeSource AncestorType=controls:TitleBarWindow}}"
                                                                   CommandParameter="{Binding}" />
                                        </i:EventTrigger>

                                        <i:EventTrigger EventName="Unchecked">
                                            <i:InvokeCommandAction Command="{Binding DataContext.UpdateProxyRuleCommand, RelativeSource={RelativeSource AncestorType=controls:TitleBarWindow}}"
                                                                   CommandParameter="{Binding}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </CheckBox>
                                <TextBlock Text="{Binding Remarks}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{l:Localize {x:Static res:LocalizationKeys.ProxyRulesGridHeaderProcesses}}" 
                                    Width="*"
                                    Binding="{Binding Processes}"
                                    ElementStyle="{StaticResource WrapTextColumnStyle}"/>
                <DataGridTextColumn Header="{l:Localize {x:Static res:LocalizationKeys.ProxyRulesGridHeaderTargetHosts}}" 
                                    Width="*"
                                    Binding="{Binding Hosts}"
                                    ElementStyle="{StaticResource WrapTextColumnStyle}"/>
                <DataGridTextColumn Header="{l:Localize {x:Static res:LocalizationKeys.ProxyRulesGridHeaderTargetPorts}}" 
                                    Width="*"
                                    Binding="{Binding Ports}"
                                    ElementStyle="{StaticResource WrapTextColumnStyle}"/>
                <DataGridTextColumn Header="{l:Localize {x:Static res:LocalizationKeys.ProxyRulesGridHeaderProtocol}}" 
                                    Width="*"
                                    Binding="{Binding Protocol}"
                                    ElementStyle="{StaticResource WrapTextColumnStyle}"/>
                <DataGridTemplateColumn Header="{l:Localize {x:Static res:LocalizationKeys.ProxyRulesGridHeaderAction}}"
                                        Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock x:Name="ActionTextBlock" 
                                           VerticalAlignment="Center"
                                           Margin="5 0">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource ActionToLocalizeConverter}">
                                            <Binding Path="Action"/>
                                            <Binding Path="CurrentCulture"
                                                     Source="{x:Static core:Localizer.Current}"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <ComboBox ItemsSource="{Binding Path=DataContext.Actions, RelativeSource={RelativeSource AncestorType=controls:TitleBarWindow}}"
                                          SelectedItem="{Binding Action, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValue="{Binding Action.Id, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Id"
                                          Margin="0 0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource ActionToLocalizeConverter}">
                                                        <Binding/>
                                                        <Binding Path="CurrentCulture"
                                                                 Source="{x:Static core:Localizer.Current}"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>

                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged">
                                            <i:InvokeCommandAction Command="{Binding DataContext.UpdateProxyRuleCommand, RelativeSource={RelativeSource AncestorType=controls:TitleBarWindow}}"
                                                                   CommandParameter="{Binding}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>

                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                                             Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>
                                </ComboBox>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="0"
              Grid.Column="1"
              Margin="0 20 0 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="25" />
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.Resources>
                <Style x:Key="TaskButton" 
                       TargetType="Button"
                       BasedOn="{StaticResource ControlButton}">
                    <Setter Property="IsEnabled" Value="True"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedIndex, ElementName=ProxyRulesDataGrid}"
                                     Value="-1">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>

            </Grid.Resources>

            <StackPanel Grid.Row="0">
                <Button Content="{l:Localize {x:Static res:LocalizationKeys.ProxyRulesButtonAdd}}"
                        Style="{StaticResource ControlButton}"
                        Command="{Binding AddProxyRuleCommand}"/>
                <Button Content="{l:Localize {x:Static res:LocalizationKeys.ProxyRulesButtonEdit}}"
                        Style="{StaticResource TaskButton}"
                        Command="{Binding EditProxyRuleCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=ProxyRulesDataGrid}"/>
                <Button Content="{l:Localize {x:Static res:LocalizationKeys.ProxyRulesButtonRemove}}"
                        Style="{StaticResource TaskButton}"
                        Command="{Binding DeleteProxyRuleCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=ProxyRulesDataGrid}"/>
            </StackPanel>

            <StackPanel Grid.Row="2">
                <Button Content="{l:Localize {x:Static res:LocalizationKeys.ProxyRulesButtonUp}}"
                        Style="{StaticResource TaskButton}"
                        Command="{Binding MoveProxyRuleUpCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=ProxyRulesDataGrid}"/>
                <Button Content="{l:Localize {x:Static res:LocalizationKeys.ProxyRulesButtonDown}}"
                        Style="{StaticResource TaskButton}"
                        Command="{Binding MoveProxyRuleDownCommand}"
                        CommandParameter="{Binding SelectedItem, ElementName=ProxyRulesDataGrid}"/>
            </StackPanel>
        </Grid>


        <UniformGrid Grid.Row="1"
                     Grid.Column="0"
                     Rows="1"
                     HorizontalAlignment="Right">
            <Button Content="{l:Localize {x:Static res:LocalizationKeys.SharedOK}}"
                    Style="{StaticResource ControlButton}"
                    IsDefault="True"
                    Command="{Binding ConfirmCommand}"/>
            <Button Content="{l:Localize {x:Static res:LocalizationKeys.SharedCancel}}"
                    Style="{StaticResource ControlButton}"
                    IsCancel="True"/>
        </UniformGrid>

        <Button Grid.Row="1"
                Grid.Column="1"
                Content="{l:Localize {x:Static res:LocalizationKeys.SharedApply}}"
                Style="{StaticResource ControlButton}"
                Command="{Binding ApplyCommand}"/>
    </Grid>
</controls:TitleBarWindow>
